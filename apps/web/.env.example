# Next.js server-only backend origin: no credentials, path or query string.
ASTANA_API_URL=http://127.0.0.1:8000
# Explicit permission to display the backend's synthetic POI, default false.
ASTANA_ALLOW_FIXTURES=false
# Default: public vector basemap and 3D buildings, no key required.
# openfreemap | osm (raster only) | none (no external basemap requests).
ASTANA_MAP_PROVIDER=openfreemap
# TomTom and OpenAI/NVIDIA keys belong only in the Python API environment.
# Never put provider secrets in NEXT_PUBLIC_* or this browser application's settings.
