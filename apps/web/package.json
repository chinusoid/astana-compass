{
  "name": "@astana/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/prepare-map.mjs && next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/generate-validators.mjs --check && node scripts/prepare-map.mjs && next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare deploy -- --keep-vars",
    "start": "node scripts/prepare-map.mjs && next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p ../../tests/e2e/tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/generate-validators.mjs --check && vitest run",
    "validators:generate": "node scripts/generate-validators.mjs",
    "validators:check": "node scripts/generate-validators.mjs --check",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:ios": "playwright test --config playwright.ios.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:live:local": "playwright test --config playwright.live-local.config.ts"
  },
  "dependencies": {
    "@astana/api-client": "file:../../packages/api_client",
    "@opennextjs/cloudflare": "1.20.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.59.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
