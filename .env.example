# Copy locally; never commit real keys. Use scripts/dev.ps1 -EnvFile .env
# on Windows, uv run --env-file .env elsewhere, or export process variables.
ASTANA_MODE=fixture
CORS_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=30
# none | openai | nvidia; model must be available to your account.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Alternative generic server-only key (provider-specific key takes precedence).
LLM_API_KEY=
# Shared across hosted intent parsing and recommendation explanations.
# Per process; resets on restart. Zero disables paid requests. Not a money cap.
ASTANA_LLM_REQUESTS_PER_MINUTE=10
ASTANA_LLM_REQUESTS_PER_DAY=100
# All factories are installed. Live mode requires an explicit local OSM snapshot.
ASTANA_REPOSITORY_FACTORY=astana_city_data:create_repository
ASTANA_RETRIEVER_FACTORY=astana_retrieval:create_retriever
ASTANA_CONTEXT_FACTORY=astana_city_context:create_context
# Resolved relative to the repository root by scripts/dev.ps1.
ASTANA_POI_PATH=data/samples/astana-osm.json
ASTANA_POI_STALE_SECONDS=604800
# Current prototype uses immutable JSON + lexical BM25; these are future settings.
DATABASE_URL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
ROUTING_PROVIDER=openrouteservice
# For a low-volume noncommercial test, opt in to keyless FOSSGIS foot routing:
# ROUTING_PROVIDER=osrm_public
ROUTING_API_KEY=
# Optional alias; ROUTING_API_KEY takes precedence.
ORS_API_KEY=
ASTANA_ROUTE_ALLOW_APPROXIMATE=true
# Optional metres/second; empty uses the adapter default.
ASTANA_WALKING_PACE_MPS=
ASTANA_CONTEXT_TIMEOUT_SECONDS=6
ASTANA_CONTEXT_RETRIES=1
WEATHER_PROVIDER=open_meteo
# Opt in only after reviewing Open-Meteo's applicable usage terms.
ASTANA_WEATHER_ENABLED=false
# Frontend server settings; see apps/web/.env.example. No browser provider keys.
ASTANA_API_URL=http://127.0.0.1:8000
ASTANA_ALLOW_FIXTURES=false
ASTANA_MAP_PROVIDER=openfreemap

# Optional, server-only real traffic. No key means an honest unavailable state.
TOMTOM_API_KEY=

# Explicit clicks query OpenStreetMap; cached, 60 fresh areas/day, 5s spacing.
# Public endpoints are for low-volume evaluation. Use a contracted/self-hosted
# endpoint for larger deployments; see docs/operations/map-services.md.
ASTANA_MAP_LOOKUP_ENABLED=false
ASTANA_MAP_LOOKUP_PROVIDER=nominatim
# Optional server-configured HTTPS endpoint; never supplied by clients.
ASTANA_MAP_LOOKUP_URL=
