# Copy locally; never commit real keys. Run through uvicorn --env-file only if
# python-dotenv is installed, or export variables in your shell/process manager.
ASTANA_MODE=fixture
CORS_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=30
# none | openai | nvidia; model must be available to your account.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Alternative generic server-only key (provider-specific key takes precedence).
LLM_API_KEY=
# Context is installed; live data/search still require their team packages.
ASTANA_REPOSITORY_FACTORY=astana_city_data:create_repository
ASTANA_RETRIEVER_FACTORY=astana_retrieval:create_retriever
ASTANA_CONTEXT_FACTORY=astana_city_context:create_context
DATABASE_URL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
ROUTING_PROVIDER=openrouteservice
ROUTING_API_KEY=
# Optional alias; ROUTING_API_KEY takes precedence.
ORS_API_KEY=
ASTANA_ROUTE_ALLOW_APPROXIMATE=true
# Optional metres/second; empty uses the adapter default.
ASTANA_WALKING_PACE_MPS=
ASTANA_CONTEXT_TIMEOUT_SECONDS=6
ASTANA_CONTEXT_RETRIES=1
WEATHER_PROVIDER=open_meteo
# Opt in only after reviewing Open-Meteo's applicable usage terms.
ASTANA_WEATHER_ENABLED=false
# Frontend server settings; see apps/web/.env.example. No browser provider keys.
ASTANA_API_URL=http://127.0.0.1:8000
ASTANA_ALLOW_FIXTURES=false
ASTANA_MAP_PROVIDER=openfreemap

# Optional, server-only real traffic. No key means an honest unavailable state.
TOMTOM_API_KEY=
